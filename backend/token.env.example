# Copia este archivo como token.env y rellena los valores.
# NUNCA subas token.env (con secretos reales) a git ni lo compartas.
ENTORNO=dev

# Token compartido de la app, usado solo para sesiones ANÓNIMAS (fallback).
# Idealmente un token de una cuenta "de servicio" con permisos mínimos de solo lectura.
GITHUB_TOKEN=

# OAuth App de GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=repo read:org read:user

# Clave de cifrado (Fernet) para guardar los tokens de usuario en BD.
# Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# URLs de la app, usadas para construir el redirect_uri y las redirecciones de vuelta al frontend.
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4000

# URL del backend del chatbot
CHAT_BACKEND_URL=http://localhost:8001